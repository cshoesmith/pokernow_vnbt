{
  "manifest_version": 3,
  "name": "Clean Poker",
  "version": "1.0.0",
  "description": "Hides clutter in the bottom-left corner of Poker Now tables.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.pokernow.com/*", "https://pokernow.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Clean Poker",
    "default_popup": "popup.html"
  }
}
