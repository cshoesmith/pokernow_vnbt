{
  "manifest_version": 3,
  "name": "vNBT Poker",
  "version": "1.1.0",
  "description": "Poker Now add-ons: beer-themed table with your own title, chip stack chart, live win chance for your hand, and less clutter.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.pokernow.com/*", "https://pokernow.com/*"],
      "js": ["content.js", "chart.js", "winodds.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["beer-table.svg"],
      "matches": ["https://www.pokernow.com/*", "https://pokernow.com/*"]
    }
  ],
  "action": {
    "default_title": "vNBT Poker",
    "default_popup": "popup.html"
  }
}
